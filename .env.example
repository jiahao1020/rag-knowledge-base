# RAG知识库 - 环境变量配置
# 复制此文件为 .env 并填入你的API密钥

# ==================== LLM API密钥 ====================

# OpenAI (GPT系列)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic (Claude系列)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Google (Gemini系列)
GOOGLE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# ==================== 配置选项 ====================

# 嵌入模型（本地）
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM提供商（openai | anthropic | google | local）
LLM_PROVIDER=openai

# LLM模型
LLM_MODEL=gpt-4o

# ==================== Qdrant（可选）====================

# Qdrant向量数据库URL（如果使用远程Qdrant）
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
